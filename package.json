{
  "name": "zenfit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ZenFit Monorepo — Next.js AI Fitness Platform & Go Speech Microservice",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=zenfit",
    "dev:web": "npm run dev --workspace=zenfit",
    "dev:speech": "cd services/speech-service && go run ./cmd/server",
    "build": "npm run build --workspace=zenfit",
    "build:web": "npm run build --workspace=zenfit",
    "build:speech": "cd services/speech-service && go build -ldflags=\"-s -w\" -o bin/speech-service ./cmd/server",
    "start": "npm run start --workspace=zenfit",
    "lint": "npm run lint --workspace=zenfit",
    "type-check": "npm run type-check --workspace=zenfit",
    "test": "npm run test --workspace=zenfit",
    "test:web": "npm run test --workspace=zenfit",
    "test:speech": "cd services/speech-service && go test -v ./...",
    "test:all": "npm run test:web && npm run test:speech",
    "test:watch": "npm run test:watch --workspace=zenfit",
    "test:e2e": "npm run test:e2e --workspace=zenfit",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "zenfit",
    "monorepo",
    "nextjs",
    "golang",
    "microservices",
    "ai"
  ],
  "author": "NEhIL06",
  "license": "UNLICENSED"
}
