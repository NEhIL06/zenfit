# ZenFit Environment Variables Template

# Core AI Providers
MISTRAL_API_KEY=""
GEMINI_API_KEY=""
HF_API_KEY=""

# RAG Reranking (optional — falls back to BM25 keyword scoring)
# Get free tier at https://cohere.com
COHERE_API_KEY=""

# Database & Vector Store
MONGODB_URI=""
CHROMA_API_KEY=""
CHROMA_TENANT_ID=""
CHROMA_DATABASE=""
CHROMA_SERVER_URL="http://localhost:8000"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key-here-minimum-32-characters"

# Image Generation & Multimodal (Nanobanana Primary, Pollinations Fallback)
NANOBANANA_API_KEY=""
POLLINATIONS_API_KEY=""
POLLINATIONS_IMAGE_MODEL="flux"
ENABLE_GEMINI_IMAGE="false"

# Upstash Redis & Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App URL (used for CORS, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"

# Docker build flag (enables Next.js standalone output)
# DOCKER_BUILD="true"
