# ZenFit Go API Gateway — Environment Configuration

PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=15

# JWT Verification (RS256 Public Key PEM or path; fallback HS256 secret)
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_SECRET=default_zenfit_jwt_secret_dev_key_32chars_min

# Redis TCP connection for Pub/Sub and Rate Limiting
REDIS_URL=redis://localhost:6379

# Downstream Microservices
AUTH_SERVICE_URL=http://localhost:3000
AI_ENGINE_URL=http://localhost:3000
SPEECH_SERVICE_URL=http://localhost:8081

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AI=10
RATE_LIMIT_AUTH=10
RATE_LIMIT_CRUD=60
