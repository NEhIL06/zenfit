# ZenFit Auth & Core Microservice Configuration
PORT=3001
ENVIRONMENT=development
LOG_LEVEL=info

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/zenfit
MONGODB_DB_NAME=zenfit
REDIS_URL=redis://localhost:6379

# Cryptographic Token Signing (RS256)
# In development, an ephemeral RSA 2048 keypair is auto-generated if unset.
# In production, provide PEM strings or mounted file paths.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
# JWT_PRIVATE_KEY_PATH="/secrets/rsa_private.pem"
# JWT_PUBLIC_KEY_PATH="/secrets/rsa_public.pem"

# Legacy Symmetric Fallback (HS256)
JWT_SECRET=default_zenfit_jwt_secret_dev_key_32chars_min

# Token Lifecycles
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30
COOKIE_NAME=zenfit_auth_token
REFRESH_COOKIE_NAME=zenfit_refresh_token

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
